#!/usr/bin/env bun
import { readdir } from "node:fs/promises";

const COMMANDS_DIR = `${import.meta.dir}/src/commands`;
const [command, ..._args] = Bun.argv.slice(2);

async function listCommands(): Promise<string[]> {
  try {
    const files = await readdir(COMMANDS_DIR);
    return files
      .filter((f) => f.endsWith(".ts") && !f.includes(".test."))
      .map((f) => f.replace(".ts", ""));
  } catch {
    return [];
  }
}

function printHelp(commands: string[]): never {
  console.log("Usage: bun cli <command>");
  console.log("Commands:");
  for (const c of commands) console.log(`  ${c}`);
  console.log("  test  (run with: bun test)");
  process.exit(command === undefined ? 0 : 1);
}

async function main() {
  const commands = await listCommands();

  if (!command || !commands.includes(command)) {
    printHelp(commands);
  }

  const mod = await import(`./src/commands/${command}.ts`);
  await mod.default();
}

await main();